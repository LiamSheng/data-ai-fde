---
import SiteNavigation from './SiteNavigation.astro';
import { SITE_NAME } from '../config/site';
import { profiles } from '../config/navigation';
---

<div class="site-header">
  <a class="site-brand" href="/">
    <svg class="site-logo" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <g class="site-logo-links">
        <line x1="5" y1="6" x2="12" y2="12" />
        <line x1="5" y1="18" x2="12" y2="12" />
        <line x1="12" y1="12" x2="19" y2="6" />
        <line x1="12" y1="12" x2="19" y2="18" />
        <line x1="5" y1="6" x2="5" y2="18" />
      </g>
      <circle cx="5" cy="6" r="2.25" />
      <circle cx="5" cy="18" r="2.25" />
      <circle cx="12" cy="12" r="3" />
      <circle cx="19" cy="6" r="2.25" />
      <circle cx="19" cy="18" r="2.25" />
    </svg>
    <span>{SITE_NAME}</span>
  </a>
  <div class="site-actions">
    <SiteNavigation />
    {
      profiles.map(({ label, href }) => (
        <a class="site-profile" href={href} rel="me" aria-label={label}>
          <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true">
            <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
          </svg>
        </a>
      ))
    }
  </div>
</div>

<script>
  // Hide the header while scrolling down; bring it back on any upward scroll or at the top.
  const header = document.querySelector<HTMLElement>('header.header');
  if (header) {
    let lastY = window.scrollY;
    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        const hide = y > lastY && y > header.offsetHeight;
        header.toggleAttribute('data-hidden', hide);
        lastY = y;
      },
      { passive: true },
    );
  }
</script>
