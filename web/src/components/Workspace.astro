---
import StatusBar from './StatusBar.astro';
import MapPanel from './MapPanel.astro';
import DetailPanel from './DetailPanel.astro';
import ChatPanel from './ChatPanel.astro';
---

<div class="aurora not-content" aria-hidden="true"><canvas data-aurora></canvas></div>
<div class="workspace not-content">
  <StatusBar />
  <MapPanel />
  <DetailPanel />
  <ChatPanel />
</div>

<script>
  import { startAurora } from '../lib/aurora';

  // The aurora's colours are tokens in global.css; the shader reads them once.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-aurora]');
  if (canvas) {
    const tokens = getComputedStyle(canvas);
    startAurora(canvas, {
      colorStops: ['--color-aurora-1', '--color-aurora-2', '--color-aurora-3', '--color-aurora-4', '--color-aurora-5'].map((name) => tokens.getPropertyValue(name).trim()),
      amplitude: 2.5,
      blend: 1.1,
      height: 0.50,
      speed: 3.0,
      scale: 1.00,
      glow: 5.0,
      brightness: 0.5,
      layers: 1,
    });
  }

  // The glass sheen follows the pointer while it is over a glass panel.
  for (const panel of document.querySelectorAll<HTMLElement>('.detail-panel, .chat-panel, .status-panel')) {
    panel.addEventListener('pointermove', (event) => {
      const box = panel.getBoundingClientRect();
      panel.style.setProperty('--glass-x', `${event.clientX - box.left}px`);
      panel.style.setProperty('--glass-y', `${event.clientY - box.top}px`);
      panel.dataset.lit = '';
    }, { passive: true });
    panel.addEventListener('pointerleave', () => delete panel.dataset.lit);
  }
</script>
