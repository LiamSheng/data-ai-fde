#!/bin/sh
# Every check before a push: collector CI checks, then the Databricks checks.
# Enabled per clone, from the repository root: git config core.hooksPath data-platform/.githooks
set -e
cd "$(git rev-parse --show-toplevel)/data-platform"
uv run --locked python scripts/check_ci.py
uv run --locked python scripts/check_databricks.py
