output "landing_reader_service_account" {
  description = "Public email of the Databricks-generated GCP identity; no key is generated by this root."
  value       = databricks_storage_credential.landing_reader.databricks_gcp_service_account[0].email
}

output "landing_external_location" {
  value = databricks_external_location.landing.name
}

output "landing_url" {
  value = databricks_external_location.landing.url
}

output "landing_region" {
  value = data.google_storage_bucket.landing.location
}
